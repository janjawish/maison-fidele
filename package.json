{
  "name": "carte-fidelite-wallet",
  "version": "1.0.0",
  "description": "A modern loyalty card MVP for Apple Wallet and Google Wallet, built with SvelteKit.",
  "private": true,
  "license": "MIT",
  "keywords": [
    "loyalty",
    "apple-wallet",
    "google-wallet",
    "sveltekit",
    "typescript",
    "drizzle",
    "sqlite"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "google-auth-library": "^11.0.2",
    "jsonwebtoken": "^9.0.2",
    "passkit-generator": "^3.5.7",
    "qrcode": "^1.5.4",
    "svelte": "^5.56.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.10",
    "svelte-check": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "cookie": "0.7.2",
    "joi": "17.13.4"
  }
