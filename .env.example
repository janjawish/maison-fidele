# Application — safe local defaults
DATABASE_URL=./data/loyalty.db
PUBLIC_BASE_URL=http://localhost:5173

# Apple Wallet (leave empty for development mode)
APPLE_PASS_TYPE_IDENTIFIER=
APPLE_TEAM_IDENTIFIER=
APPLE_ORGANIZATION_NAME=Maison Fidele
APPLE_SIGNER_CERT_PATH=
APPLE_SIGNER_KEY_PATH=
APPLE_SIGNER_KEY_PASSPHRASE=
APPLE_WWDR_CERT_PATH=

# Google Wallet (leave empty for development mode)
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_CLASS_ID=loyalty_class
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the JSON private key using literal \n characters. Never commit a real key.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
